erience our process, and scale without risk.</w:t></w:r></w:p><w:p w14:paraId="6FD3E72F" w14:textId="77777777" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:r w:rsidRPr="008E286F"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>CTA Button</w:t></w:r><w:r w:rsidRPr="008E286F"><w:br/><w:t>Chat With Operations</w:t></w:r></w:p><w:p w14:paraId="2F58F531" w14:textId="0E92F7BD" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"/><w:p w14:paraId="4A0F53B9" w14:textId="77777777" w:rsidR="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="635FFF59" w14:textId="77777777" w:rsidR="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="02C32575" w14:textId="490BC3B6" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008E286F"><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>HOW IT WORKS PAGE</w:t></w:r></w:p><w:p w14:paraId="1380A604" w14:textId="77777777" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:r w:rsidRPr="008E286F"><w:rPr><w:i/><w:iCs/></w:rPr><w:t>(Risk Removal &amp; Full Process Transparency)</w:t></w:r></w:p><w:p w14:paraId="496D96E3" w14:textId="77777777" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008E286F"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Page Introduction</w:t></w:r></w:p><w:p w14:paraId="0C424C1F" w14:textId="77777777" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:r w:rsidRPr="008E286F"><w:t>Logistics should never feel uncertain. At Quick Box, we believe clarity builds trust. Below is exactly how your inventory, orders, deliveries, and payments are handled—from start to finish.</w:t></w:r></w:p><w:p w14:paraId="666F09F1" w14:textId="74D3D830" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"/><w:p w14:paraId="4CDD43BB" w14:textId="77777777" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008E286F"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Detailed Step-by-Step Process</w:t></w:r></w:p><w:p w14:paraId="5F7C4D53" w14:textId="77777777" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:r w:rsidRPr="008E286F"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Step 1: Inventory Receiving</w:t></w:r><w:r w:rsidRPr="008E286F"><w:br/><w:t>You send your products to our fulfillment facility. Each item is counted, recorded, and organized into storage. This ensures accuracy and accountability from day one.</w:t></w:r></w:p><w:p w14:paraId="3EAF54AD" w14:textId="77777777" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:r w:rsidRPr="008E286F"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Step 2: Order Processing</w:t></w:r><w:r w:rsidRPr="008E286F"><w:br/><w:t>Orders are received either through integrated platforms or shared directly with our operations team. Every order is logged before processing begins.</w:t></w:r></w:p><w:p w14:paraId="67503D6C" w14:textId="77777777" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:r w:rsidRPr="008E286F"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Step 3: Packing &amp; Dispatch</w:t></w:r><w:r w:rsidRPr="008E286F"><w:br/><w:t>Orders are carefully packed using standard procedures and prepared for dispatch. Packages are assigned to trained riders with clear delivery instructions.</w:t></w:r></w:p><w:p w14:paraId="0C514A81" w14:textId="77777777" w:rsidR="008E286F" w:rsidRPr="008E286F" w:rsidRDefault="008E286F" w:rsidP="008E286F"><w:r w:rsidRPr="008E286F"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Step 4: Delivery &amp; COD Collect