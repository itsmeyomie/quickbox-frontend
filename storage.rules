rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Videos: public read (for home page), authenticated write (admin upload)
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // POD (proof of delivery): authenticated users only
    match /pod/{podId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
